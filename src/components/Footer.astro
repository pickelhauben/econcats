---
import nav from '../data/nav.json';
import site from '../data/site.json';
import SocialLink from './SocialLink.astro';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap grid">
    <div>
      <p class="name">{site.name}</p>
      <p>{site.fullName}<br />{site.school}</p>
      <p class="meet">Meetings: {site.meetingDay}, {site.meetingTime}<br />{site.meetingPlace}</p>
    </div>
    <nav aria-label="Footer">
      <ul>
        {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>
    <div>
      <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
      <p><SocialLink href={site.instagram} label={site.instagramHandle} /></p>
      <p><SocialLink href={site.wecInstagram} label={`WEC ${site.wecInstagramHandle}`} /></p>
      <p><SocialLink href={site.linkedin} label="LinkedIn" network="linkedin" /></p>
    </div>
  </div>
  <div class="wrap legal">
    <span>{site.fullName} ({site.name}) · {site.school} · {site.disclaimer}</span>
    <span>© {year}</span>
  </div>
</footer>

<style>
  .site-footer { background: var(--deep); color: rgba(255, 255, 255, .72); padding: 48px 0 28px; font-size: 14px; }
  .grid { display: grid; gap: 32px; }
  .name { font-family: var(--serif); font-size: 26px; color: var(--mint); margin: 0 0 8px; }
  .meet { margin-top: 16px; }
  p { margin: 0 0 8px; }
  p:has(> .social), p:has(> a) { margin: 0; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 0 24px; }
  a { text-decoration: none; }
  a:hover { color: var(--white); text-decoration: underline; }
  .legal {
    margin-top: 40px; padding-top: 20px; border-top: 1px solid rgba(255, 255, 255, .14); font-size: 13px;
    display: flex; flex-direction: column; gap: 4px;
  }
  @media (min-width: 768px) { .legal { flex-direction: row; justify-content: space-between; } }
  @media (min-width: 768px) {
    .grid { grid-template-columns: 1.4fr 1fr 1fr; }
  }
</style>
