---
// Small three-ring mark in the logo colors (green, cyan, navy). Used as an accent, not as decoration.
interface Props { size?: number; class?: string }
const { size = 56, class: className } = Astro.props;
---
<svg class={className} width={size} height={size} viewBox="0 0 60 60" aria-hidden="true" focusable="false">
  <circle cx="22" cy="24" r="14" fill="none" stroke="#375D52" stroke-width="4" />
  <circle cx="38" cy="24" r="14" fill="none" stroke="#2AACCC" stroke-width="4" />
  <circle cx="30" cy="37" r="14" fill="none" stroke="#1A3A6A" stroke-width="4" />
</svg>
