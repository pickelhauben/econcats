---
import type { Pillar } from '../lib/content';
interface Props { pillar: Pillar }
const { pillar } = Astro.props;
---
<span class={`tag tag-${pillar.toLowerCase()}`}>{pillar}</span>

<style>
  .tag {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 12px; font-weight: 500; letter-spacing: .06em; text-transform: uppercase;
    color: var(--muted);
  }
  .tag::before { content: ""; width: 8px; height: 8px; border-radius: 50%; border: 2px solid var(--c); }
  .tag-connect { --c: var(--esa-green); }
  .tag-grow { --c: var(--cyan); }
  .tag-access { --c: var(--navy); }
</style>
