---
import Tag from './Tag.astro';
import type { EventItem } from '../lib/content';
interface Props { event: EventItem }
const { event } = Astro.props;

const d = new Date(`${event.date}T12:00:00`);
const month = d.toLocaleDateString('en-US', { month: 'short' });
const day = d.toLocaleDateString('en-US', { day: 'numeric' });
const weekday = d.toLocaleDateString('en-US', { weekday: 'long' });
const full = d.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' });
const when = [weekday, event.time].filter(Boolean).join(' · ');
---
<article class="event">
  <time datetime={event.date} title={full}>
    <span class="m">{month}</span>
    <span class="d">{day}</span>
  </time>
  <div class="body">
    <div class="labels">
      <span class="type">{event.type}</span>
      <Tag pillar={event.pillar} />
    </div>
    <h3>{event.title}</h3>
    {event.summary && <p>{event.summary}</p>}
    <p class="where">{when}{event.location && <> · {event.location}</>}</p>
    {event.draft && <p class="draft">Draft: hidden on the live site until confirmed</p>}
  </div>
</article>

<style>
  .event {
    display: grid; grid-template-columns: 64px 1fr; gap: 20px;
    padding: 24px 0; border-top: 1px solid var(--rule);
  }
  time { display: flex; flex-direction: column; align-items: center; line-height: 1; padding-top: 4px; }
  .m { font-size: 12px; text-transform: uppercase; letter-spacing: .12em; color: var(--esa-green); font-weight: 600; }
  .d { font-family: var(--serif); font-size: 40px; margin-top: 6px; }
  .labels { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
  .type {
    font-size: 12px; font-weight: 500; padding: 4px 10px; border-radius: 999px;
    background: var(--paper); border: 1px solid var(--rule); color: var(--ink);
  }
  h3 { margin: 10px 0 6px; }
  p { margin: 0; color: var(--muted); font-size: 15px; }
  .where { margin-top: 10px; font-size: 14px; color: var(--ink); }
  .draft {
    display: inline-block; margin-top: 12px; font-size: 12px; color: #8a5a00;
    background: #fff4dc; padding: 3px 8px; border-radius: 4px;
  }
</style>
