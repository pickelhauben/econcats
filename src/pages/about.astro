---
import Layout from '../layouts/Layout.astro';
import SocialLink from '../components/SocialLink.astro';
import AdvisorList from '../components/AdvisorList.astro';
import site from '../data/site.json';
import {
  pillars, timeline, achievementsFor, presidentsFor, type OrgId,
} from '../lib/content';

type Link = { text: string; href: string; external?: boolean; instagram?: boolean };
const orgs: { id: OrgId; name: string; short: string; color: string; logo?: string; body: string; links: Link[]; showPresidents?: boolean }[] = [
  {
    id: 'ees', short: 'EES', name: 'Eller Economics Society', color: 'var(--esa-green)', logo: '/logos/ees.png',
    body: 'Generations of economics students at Arizona have met through the economics society. In its most recent era it adopted a constitution on November 13, 2024, rebuilt its board and programming, and won the Eller Experience Award.',
    links: [],
    showPresidents: true,
  },
  {
    id: 'wec', short: 'WEC', name: 'Women in Economics Club', color: 'var(--wec)', logo: '/logos/wec.jpg',
    body: 'Founded in fall 2018 by economics lecturer Erin Yetter to create a space for women in economics. Its first meeting, on April 9, 2019, drew more than 20 students from a range of majors. WEC grew through professional development workshops, community service and social events. Its women-only socials remain a permanent part of ESA.',
    links: [{ text: site.wecInstagramHandle, href: site.wecInstagram, instagram: true }],
  },
  {
    id: 'ode', short: 'OΔE', name: 'Omicron Delta Epsilon, Arizona Beta', color: 'var(--ode)', logo: '/logos/ode.png',
    body: 'Arizona’s chapter of the international honor society in economics, founded in 1915. Reactivated in 2026, its first active year in nearly two decades.',
    links: [
      { text: 'About our chapter', href: '/projects#ode' },
      { text: 'ODE International', href: site.odeInternational, external: true },
    ],
  },
];

const orgColor: Record<OrgId, string> = {
  esa: 'var(--deep)', ees: 'var(--esa-green)', wec: 'var(--wec-ink)', ode: 'var(--ode)',
};
---
<Layout title="About" description="How three student organizations came together as the Economics Student Association at the University of Arizona.">

  <!-- 1. Intro -->
  <section class="page-intro wrap intro">
    <p class="eyebrow">About</p>
    <h1>About the <em>EconCats.</em></h1>
    <p class="lede">The Economics Student Association brings together three student organizations that each served economics students at Arizona in their own way. In 2026 they came together as one association, built on three pillars: Connect, Grow and Access.</p>
  </section>

  <!-- 2. Mission -->
  <section class="section" id="mission">
    <div class="wrap">
      <p class="eyebrow">Mission</p>
      <h2 class="sr-only">Our mission</h2>
      <p class="mission">ESA builds an inclusive, high-performing economics community: connecting students to each other, developing their academic and professional abilities, and opening doors to opportunities in economics, policy and finance.</p>
      <ol class="pillars">
        {pillars.map((p, i) => (
          <li style={`--c: var(--${p.color})`}>
            <span class="num">0{i + 1}</span>
            <h3>{p.name}</h3>
            <p>{p.line}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 3. Heritage -->
  <section class="section tint" id="heritage">
    <div class="wrap">
      <p class="eyebrow">Our heritage</p>
      <h2>Three organizations, <em>three stories.</em></h2>

      <div class="orgs">
        {orgs.map((o) => {
          const achievements = achievementsFor(o.id);
          const presidents = presidentsFor(o.id);
          return (
            <article class="org" id={o.id} style={`--c:${o.color}; --c-ink:${o.color === 'var(--wec)' ? 'var(--wec-ink)' : o.color}`} aria-labelledby={`${o.id}-title`}>
              <header>
                {o.logo
                  ? <img class="org-logo" src={o.logo} width="56" height="56" alt={`${o.name} logo`} loading="lazy" decoding="async" />
                  : <span class="dot" aria-hidden="true"></span>}
                <span class="short">{o.short}</span>
                <h3 id={`${o.id}-title`}>{o.name}</h3>
              </header>
              <div class="org-body">
                <p>{o.body}</p>

                {o.links.length > 0 && (
                  <ul class="org-links">
                    {o.links.map((l) => (
                      <li>
                        {l.instagram
                          ? <SocialLink class="org-link" href={l.href} label={l.text} />
                          : l.external
                            ? <a class="org-link" href={l.href} target="_blank" rel="noopener noreferrer">{l.text} <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></a>
                            : <a class="org-link" href={l.href}>{l.text} <span aria-hidden="true">→</span></a>}
                      </li>
                    ))}
                  </ul>
                )}

                <div class="lists">
                  <div>
                    <h4>Achievements</h4>
                    {achievements.length > 0
                      ? <ul class="list">{achievements.map((a) => <li>{a.title}{a.year && <span class="meta"> · {a.year}</span>}</li>)}</ul>
                      : <p class="soon">Coming soon.</p>}
                  </div>
                  {o.showPresidents && (
                    <div>
                      <h4>Past presidents</h4>
                      {presidents.length > 0
                        ? <ul class="list">{presidents.map((p) => <li>{p.name}{p.term && <span class="meta"> · {p.term}</span>}</li>)}</ul>
                        : <p class="soon">Coming soon.</p>}
                    </div>
                  )}
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- 4. Timeline -->
  <section class="section" id="timeline">
    <div class="wrap timeline-grid">
      <div>
        <p class="eyebrow">Timeline</p>
        <h2>How we got <em>here.</em></h2>
      </div>
      <ol class="timeline">
        {timeline.map((m, i) => (
          <li style={`--c:${orgColor[m.org]}`} class:list={[{ open: i === 0 }]}>
            <span class="when">{m.when}</span>
            <span class="what">{m.text}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 5. Advisors -->
  <section class="section tint" id="advisors">
    <div class="wrap">
      <p class="eyebrow">Advisors</p>
      <h2>Our faculty <em>advisors.</em></h2>
      <AdvisorList />
    </div>
  </section>

  <!-- 6. Closing -->
  <section class="closing">
    <div class="wrap">
      <h2>Have a piece of <em>our history?</em></h2>
      <p>Old photos, flyers or stories from your time in EES, WEC or ODE help us keep the record.</p>
      <a class="btn primary" href="/alumni">Share your story <span aria-hidden="true">→</span></a>
    </div>
  </section>
</Layout>

<style>
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  h2 { margin-top: 16px; }
  [id] { scroll-margin-top: calc(var(--header-h) + 16px); }

  /* 1. Intro */
  .intro .lede { margin-top: 24px; }

  /* 2. Mission */
  .mission {
    font-family: var(--serif); font-size: clamp(24px, 3.6vw, 40px); line-height: 1.25;
    letter-spacing: -0.01em; margin: 20px 0 48px; max-width: 26em;
  }
  .pillars { list-style: none; margin: 0; padding: 0; display: grid; }
  .pillars li { padding: 24px 0; border-top: 1px solid var(--rule); }
  .pillars .num { font-size: 13px; font-weight: 600; letter-spacing: .1em; color: var(--c); }
  .pillars h3 { font-size: 32px; color: var(--c); margin: 6px 0 8px; }
  .pillars p { margin: 0; color: var(--muted); }
  @media (min-width: 900px) { .pillars { grid-template-columns: repeat(3, 1fr); gap: 40px; } }

  /* 3. Heritage */
  .tint { background: var(--paper); }
  .orgs { margin-top: 40px; display: grid; gap: 24px; }
  .org {
    background: var(--white); border: 1px solid var(--rule); border-radius: 6px;
    padding: 28px 24px; display: grid; gap: 20px;
  }
  .org header { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
  .org-logo { display: block; width: 56px; height: 56px; border-radius: 50%; object-fit: cover; flex: 0 0 auto; }
  .dot { width: 14px; height: 14px; border-radius: 50%; background: var(--c); }
  .short { font-size: 13px; font-weight: 600; letter-spacing: .12em; color: var(--c-ink, var(--c)); }
  .org h3 { flex-basis: 100%; font-size: clamp(26px, 3vw, 34px); }
  .org-body > p { margin: 0; max-width: 40em; }
  .org-links { list-style: none; margin: 16px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 12px 24px; }
  .org-link { font-size: 14px; font-weight: 500; color: var(--ink); text-decoration: underline; text-decoration-color: var(--c); text-underline-offset: 4px; }
  .org-link:hover { color: var(--esa-green); }
  .lists { margin-top: 24px; display: grid; gap: 20px; }
  h4 { margin: 0 0 8px; font-size: 12px; font-weight: 500; letter-spacing: .16em; text-transform: uppercase; color: var(--muted); }
  .list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--rule); }
  .list li { padding: 10px 0; border-bottom: 1px solid var(--rule); font-size: 15px; }
  .meta { color: var(--muted); }
  .soon { margin: 0; color: var(--muted); font-size: 15px; font-style: italic; }
  .soon.big { margin-top: 24px; font-size: 18px; }
  @media (min-width: 900px) {
    .org { grid-template-columns: 1fr 2fr; gap: 48px; padding: 40px; }
    .org header { align-content: flex-start; }
    .lists { grid-template-columns: 1fr 1fr; gap: 32px; }
  }

  /* 4. Timeline */
  .timeline-grid { display: grid; gap: 32px; }
  .timeline { list-style: none; margin: 0; padding: 0; position: relative; }
  .timeline::before { content: ""; position: absolute; left: 6px; top: 8px; bottom: 8px; width: 2px; background: var(--rule); }
  .timeline li { position: relative; padding: 0 0 28px 36px; display: grid; gap: 2px; }
  .timeline li:last-child { padding-bottom: 0; }
  .timeline li::before {
    content: ""; position: absolute; left: 0; top: 4px;
    width: 14px; height: 14px; border-radius: 50%; background: var(--c); box-shadow: 0 0 0 4px var(--white);
  }
  .timeline li.open::before { background: var(--white); border: 2px solid var(--c); box-sizing: border-box; }
  .when { font-size: 13px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--c); }
  .what { font-family: var(--serif); font-size: 22px; line-height: 1.3; }
  @media (min-width: 900px) { .timeline-grid { grid-template-columns: 1fr 2fr; gap: 80px; } }

  /* 6. Closing */
  .closing { padding: 72px 0; text-align: center; border-top: 1px solid var(--rule); }
  .closing p { color: var(--muted); max-width: 32em; margin: 16px auto 28px; }
  @media (min-width: 768px) { .closing { padding: 112px 0; } }
</style>
