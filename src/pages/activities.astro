---
import Layout from '../layouts/Layout.astro';
import EventCard from '../components/EventCard.astro';
import Tag from '../components/Tag.astro';
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { upcomingEvents, pastEventsBySemester, meetingsLine, type EventItem } from '../lib/content';
import { resolvePhoto } from '../lib/photos';

const upcoming = upcomingEvents();
const past = pastEventsBySemester();

// Build each past event's gallery: optimized thumbnail + large version for the lightbox, with alt text.
type GalleryPhoto = { thumb: ImageMetadata; large: string; alt: string };
const longDate = (date: string) =>
  new Date(`${date}T12:00:00`).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });

async function galleryFor(e: EventItem): Promise<GalleryPhoto[]> {
  const alts = (e.photo_alts ?? '').split('|').map((a) => a.trim());
  const out: GalleryPhoto[] = [];
  for (const [i, path] of (e.photos ?? []).entries()) {
    const img = resolvePhoto(path);
    if (!img) continue;
    let alt = alts[i];
    if (!alt) {
      console.warn(`[photos] "${path}" (${e.title}) has no alt text; add it to the photo_alts column.`);
      alt = `${e.title}, ${longDate(e.date)}`;
    }
    const large = await getImage({ src: img, width: Math.min(img.width, 1600), format: 'webp' });
    out.push({ thumb: img, large: large.src, alt });
  }
  return out;
}

const galleries = new Map<EventItem, GalleryPhoto[]>();
for (const group of past) for (const e of group.events) galleries.set(e, await galleryFor(e));

const rhythm = [
  { week: 'Week 1', name: 'General meeting' },
  { week: 'Week 2', name: 'Speaker' },
  { week: 'Week 3', name: 'Workshop or employer event' },
  { week: 'Week 4', name: 'Committee meeting' },
];

const shortDate = (date: string) =>
  new Date(`${date}T12:00:00`).toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: 'numeric' });
---
<Layout title="Activities" description="Weekly meetings, speakers, workshops, exam reviews and socials from the Economics Student Association at the University of Arizona.">

  <!-- 1. Intro -->
  <section class="page-intro wrap">
    <p class="eyebrow">Activities</p>
    <h1>What EconCats <em>do.</em></h1>
    <p class="lede">Weekly meetings, speakers, workshops, exam reviews and socials, every week of the semester.</p>
  </section>

  <!-- 2. Coming up -->
  <section class="section" id="upcoming">
    <div class="wrap split">
      <div>
        <p class="eyebrow">Calendar</p>
        <h2>Coming <em>up</em></h2>
      </div>
      <div>
        {upcoming.length > 0
          ? <div class="events">{upcoming.map((e) => <EventCard event={e} />)}</div>
          : <p class="empty">Our next schedule is coming soon. Meetings are {meetingsLine}.</p>}
      </div>
    </div>
  </section>

  <!-- 3. Weekly rhythm -->
  <section class="section tint" id="rhythm">
    <div class="wrap">
      <p class="eyebrow">Every Thursday</p>
      <h2>Our weekly <em>rhythm</em></h2>
      <p class="intro">Each month of the semester follows the same Thursday cycle.</p>
      <ol class="rhythm">
        {rhythm.map((r, i) => (
          <li>
            <span class="step">{r.week}</span>
            <span class="name">{r.name}</span>
            {i < rhythm.length - 1 && <span class="arrow" aria-hidden="true">→</span>}
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 4. Past events -->
  <section class="section" id="past">
    <div class="wrap">
      <p class="eyebrow">Archive</p>
      <h2>Past <em>events</em></h2>

      {past.length === 0 && <p class="empty">Past events will appear here after our first meetings.</p>}

      {past.map((group) => (
        <div class="semester">
          <h3 class="semester-title">{group.semester}</h3>
          <ul class="past-list">
            {group.events.map((e) => (
              <li class="past">
                <time datetime={e.date}>{shortDate(e.date)}</time>
                <div>
                  <div class="labels"><span class="type">{e.type}</span><Tag pillar={e.pillar} /></div>
                  <h4>{e.title}</h4>
                  <p>{e.summary}</p>
                  {e.recap && <p class="recap">{e.recap}</p>}
                  {(() => {
                    const gallery = galleries.get(e) ?? [];
                    if (gallery.length === 0) return null;
                    const data = JSON.stringify(gallery.map((g) => ({ src: g.large, alt: g.alt })));
                    return (
                      <ul class="thumbs" aria-label={`Photos from ${e.title}`}>
                        {gallery.map((g, i) => (
                          <li>
                            <button
                              type="button"
                              class="thumb"
                              data-gallery={data}
                              data-title={e.title}
                              data-index={i}
                              aria-label={`Open photo ${i + 1} of ${gallery.length}: ${g.alt}`}
                            >
                              <Image src={g.thumb} alt="" width={96} height={72} densities={[1, 2]} format="webp" loading="lazy" />
                            </button>
                          </li>
                        ))}
                      </ul>
                    );
                  })()}
                </div>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- Lightbox (shared) -->
  <dialog class="lightbox" aria-label="Photo gallery">
    <div class="lb-inner">
      <button type="button" class="lb-close" aria-label="Close gallery">×</button>
      <figure>
        <img class="lb-img" src="" alt="" />
        <figcaption class="lb-caption"></figcaption>
      </figure>
      <button type="button" class="lb-prev" aria-label="Previous photo">←</button>
      <button type="button" class="lb-next" aria-label="Next photo">→</button>
    </div>
  </dialog>
</Layout>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('.lightbox');
  if (dialog) {
    const img = dialog.querySelector<HTMLImageElement>('.lb-img')!;
    const caption = dialog.querySelector<HTMLElement>('.lb-caption')!;
    const prev = dialog.querySelector<HTMLButtonElement>('.lb-prev')!;
    const next = dialog.querySelector<HTMLButtonElement>('.lb-next')!;
    let photos: { src: string; alt: string }[] = [];
    let index = 0;
    let title = '';
    let opener: HTMLElement | null = null;

    const show = (i: number) => {
      index = (i + photos.length) % photos.length;
      img.src = photos[index].src;
      img.alt = photos[index].alt;
      caption.textContent = `${title} · ${index + 1} / ${photos.length}`;
      const many = photos.length > 1;
      prev.hidden = !many;
      next.hidden = !many;
    };

    document.querySelectorAll<HTMLButtonElement>('.thumb').forEach((btn) => {
      btn.addEventListener('click', () => {
        photos = JSON.parse(btn.dataset.gallery || '[]');
        title = btn.dataset.title || '';
        opener = btn;
        show(Number(btn.dataset.index || 0));
        dialog.showModal(); // Esc closes a modal dialog natively; focus stays inside it
      });
    });

    prev.addEventListener('click', () => show(index - 1));
    next.addEventListener('click', () => show(index + 1));
    dialog.querySelector('.lb-close')!.addEventListener('click', () => dialog.close());
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft' && photos.length > 1) show(index - 1);
      if (e.key === 'ArrowRight' && photos.length > 1) show(index + 1);
    });
    // Click on the dark backdrop closes
    dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
    dialog.addEventListener('close', () => opener?.focus());
  }
</script>

<style>
  .page-intro .lede { margin-top: 24px; }
  h2 { margin-top: 16px; }
  .intro { color: var(--muted); margin: 16px 0 0; }
  .tint { background: var(--paper); }
  .empty { margin: 0; padding: 24px; border: 1px dashed var(--rule); border-radius: 6px; color: var(--muted); background: var(--white); }
  #past .empty { margin-top: 32px; }

  /* Coming up */
  .split { display: grid; gap: 32px; }
  .events { border-bottom: 1px solid var(--rule); }
  @media (min-width: 900px) { .split { grid-template-columns: 1fr 2fr; gap: 80px; } }

  /* Rhythm */
  .rhythm { list-style: none; margin: 32px 0 0; padding: 0; display: grid; gap: 12px; }
  .rhythm li {
    position: relative; display: flex; flex-direction: column; gap: 4px;
    background: var(--white); border: 1px solid var(--rule); border-radius: 6px; padding: 20px;
  }
  .step { font-size: 12px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: var(--esa-green); }
  .name { font-family: var(--serif); font-size: 22px; line-height: 1.25; }
  .arrow { display: none; }
  @media (min-width: 900px) {
    .rhythm { grid-template-columns: repeat(4, 1fr); gap: 32px; }
    .arrow {
      display: block; position: absolute; right: -24px; top: 50%; transform: translateY(-50%);
      color: var(--muted);
    }
  }

  /* Past events */
  .semester { margin-top: 48px; }
  .semester-title {
    font-family: var(--sans); font-size: 13px; font-weight: 600; letter-spacing: .14em;
    text-transform: uppercase; color: var(--muted); margin-bottom: 8px;
  }
  .past-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--rule); }
  .past { display: grid; gap: 8px; padding: 24px 0; border-bottom: 1px solid var(--rule); }
  .past time { font-size: 14px; color: var(--esa-green); font-weight: 500; }
  .labels { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
  .type {
    font-size: 12px; font-weight: 500; padding: 4px 10px; border-radius: 999px;
    background: var(--paper); border: 1px solid var(--rule);
  }
  .past h4 { font-family: var(--serif); font-weight: 400; font-size: 24px; letter-spacing: -0.01em; margin: 10px 0 6px; }
  .past p { margin: 0; color: var(--muted); max-width: 40em; }
  .past .recap { margin-top: 10px; color: var(--ink); }
  @media (min-width: 768px) { .past { grid-template-columns: 140px 1fr; gap: 32px; } .past time { padding-top: 4px; } }

  .thumbs { list-style: none; margin: 16px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .thumb { padding: 0; border: 0; background: none; cursor: zoom-in; border-radius: 4px; overflow: hidden; display: block; }
  .thumb :global(img) { width: 96px; height: 72px; object-fit: cover; transition: transform .3s; }
  .thumb:hover :global(img) { transform: scale(1.05); }

  /* Lightbox */
  .lightbox {
    width: 100%; max-width: 100%; height: 100%; max-height: 100%; margin: 0; padding: 0;
    border: 0; background: rgba(10, 20, 18, .94); color: var(--white);
  }
  .lightbox::backdrop { background: rgba(10, 20, 18, .6); }
  .lb-inner { position: relative; height: 100%; display: grid; place-items: center; padding: 64px 16px; }
  .lightbox figure { margin: 0; display: flex; flex-direction: column; align-items: center; gap: 12px; max-width: 100%; }
  .lb-img { max-width: min(1100px, 100%); max-height: calc(100dvh - 160px); object-fit: contain; border-radius: 4px; }
  .lb-caption { font-size: 14px; color: rgba(255, 255, 255, .8); text-align: center; }
  .lb-close, .lb-prev, .lb-next {
    position: absolute; width: 48px; height: 48px; border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, .35); background: rgba(0, 0, 0, .3); color: var(--white);
    font-size: 22px; cursor: pointer; display: grid; place-items: center;
  }
  .lb-close:hover, .lb-prev:hover, .lb-next:hover { background: rgba(255, 255, 255, .15); }
  .lb-close { top: 12px; right: 12px; }
  .lb-prev { left: 12px; top: 50%; transform: translateY(-50%); }
  .lb-next { right: 12px; top: 50%; transform: translateY(-50%); }
  .lb-prev[hidden], .lb-next[hidden] { display: none; }
  @media (prefers-reduced-motion: reduce) { .thumb :global(img) { transition: none; } }
</style>
